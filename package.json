{
  "name": "riftfall",
  "private": true,
  "version": "0.1.0",
  "description": "RIFTFALL – browser first-person sci-fi horror wave shooter",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "assets": "node scripts/fetch-assets.mjs",
    "smoke": "node tools/smoke.mjs",
    "postinstall": "node scripts/copy-decoders.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "preact": "^10.29.8",
    "three": "~0.186.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@types/three": "~0.186.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
